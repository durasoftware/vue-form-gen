{
  "name": "@durasoftware/vue-form-gen",
  "version": "0.1.2",
  "type": "module",
  "author": "durasoft",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:lib": "vite build --mode lib && vue-tsc -p tsconfig.lib.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11",
    "vue": "^3.5.42"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/vue-form-gen.js",
  "module": "./dist/vue-form-gen.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/vue-form-gen.js"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
